// Synthetic primer and all-container smoke tests; no classifier or metadata required.
params {
    test = true
    region = 'V3V4'
    primer_f = 'ACGTACGTACGT'
    test_r1 = "${projectDir}/tests/fixtures/r1.fastq"
    test_r2 = "${projectDir}/tests/fixtures/r2.fastq"
    outdir = 'results/primer-test'
}
process {
    withLabel: process_low {
        cpus = 2
        memory = '2 GB'
        time = '10m'
    }
    withLabel: process_medium {
        cpus = 2
        memory = '4 GB'
        time = '20m'
    }
}
