nextflow.enable.dsl = 2

includeConfig 'conf/base.config'

params {
  test = false
  reads = null
  outdir = 'results'
  run_label = 'amplicon'
  region = 'V1V3'
  primer_f = null
  primer_r = null
  adapter_f = null
  adapter_r = null
  quality = 20
  min_length = 50
  dada2_trunc_len_f = 0
  dada2_trunc_len_r = 0
  dada2_max_ee_f = 2
  dada2_max_ee_r = 4
  classifier = null
  metadata = null
  sampling_depth = 1000
  alpha_max_depth = 10000
  diversity_enabled = true

  // Optional local images; otherwise use the public images in modules/*.nf.
  qc_sif = null
  cutadapt_sif = null
  qiime_sif = null

  trimm_optimal = false
  trimm_combinations = null
  taxonomy_confidence = 0.7
  taxonomy_label = 'AUTO'
  optimal_min_sample_reads = 10000
}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']
}

singularity { enabled = true; autoMounts = true }

manifest {
  version = '0.0.9'
  nextflowVersion = '>=26.04.2'
}

profiles {
  singularity {
    docker.enabled = false
    apptainer.enabled = false
    singularity.enabled = true
    singularity.autoMounts = true
  }
  docker {
    singularity.enabled = false
    apptainer.enabled = false
    docker.enabled = true
  }
  apptainer {
    singularity.enabled = false
    docker.enabled = false
    apptainer.enabled = true
    apptainer.autoMounts = true
  }
  test {
    includeConfig 'conf/test.config'
  }
}
