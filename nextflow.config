nextflow.enable.dsl = 2

includeConfig 'conf/base.config'

params {
  reads = null
  outdir = 'results'
  run_label = 'amplicon'
  region = 'V1V3'
  primer_f = null
  primer_r = null
  adapter_f = null
  adapter_r = null
  quality = 20
  min_length = 50
  dada2_trunc_len_f = 0
  dada2_trunc_len_r = 0
  dada2_max_ee_f = 2
  dada2_max_ee_r = 4
  classifier = null
  metadata = null
  sampling_depth = 1000
  alpha_max_depth = 10000
  diversity_enabled = true

  qc_sif = '/data/software/singularity/qc_fastqc_multiqc.sif'
  cutadapt_sif = '/data/software/singularity/read_cleanup_cutadapt-5.2.sif'
  qiime_sif = '/data/software/singularity/qiime2_amplicon_2025.7.sif'

  trimm_optimal = false
  trimm_combinations = null
  taxonomy_confidence = 0.7
  taxonomy_label = 'AUTO'
  optimal_min_sample_reads = 10000
}

process {
  executor = 'local'
  shell = ['/bin/bash', '-euo', 'pipefail']
}

singularity { enabled = true; autoMounts = true }

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }
}
